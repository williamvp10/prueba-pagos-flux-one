{
  "name": "prueba-pagos-flux-one",
  "private": true,
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm --filter @fluxone/backend-kit build && pnpm --filter \"@fluxone/auth\" --filter \"@fluxone/payments\" --filter \"@fluxone/audit\" build",
    "typecheck": "pnpm -r --if-present typecheck",
    "contracts": "openapi-typescript docs/openapi.yaml -o packages/api-client/src/services.d.ts && openapi-typescript docs/browser.openapi.yaml -o packages/api-client/src/browser.d.ts",
    "test": "pnpm build && pnpm --filter @fluxone/payments test && node --test tests/*.test.cjs",
    "test:unit": "pnpm build && pnpm --filter @fluxone/payments test",
    "setup": "node tools/setup-env.mjs"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "@types/node": "^24.10.1",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/amqplib": "^0.10.7",
    "@types/js-yaml": "^4.0.9",
    "openapi-typescript": "^7.10.1"
  }
}
