# En Dokploy debe quedar en production.
NODE_ENV=production
# En Dokploy: reemplazar por https://<dominio-publico> sin slash final.
APP_ORIGIN=http://localhost:3000
# Solo se usa con docker-compose.dev.yml.
WEB_PORT=3000
LOG_LEVEL=info
# Solo para comandos locales fuera de Compose; los servicios Compose usan sus DNS privados.
DB_HOST=localhost
DB_PORT=15432
POSTGRES_DB=fluxone
POSTGRES_USER=fluxone_admin
POSTGRES_PASSWORD=GENERATE_WITH_SETUP
AUTH_DB_USER=auth_app
AUTH_DB_PASSWORD=GENERATE_WITH_SETUP
PAYMENTS_DB_USER=payments_app
PAYMENTS_DB_PASSWORD=GENERATE_WITH_SETUP
AUDIT_DB_USER=audit_app
AUDIT_DB_PASSWORD=GENERATE_WITH_SETUP
AUTH_MIGRATION_USER=auth_migration
AUTH_MIGRATION_PASSWORD=GENERATE_WITH_SETUP
PAYMENTS_MIGRATION_USER=payments_migration
PAYMENTS_MIGRATION_PASSWORD=GENERATE_WITH_SETUP
AUDIT_MIGRATION_USER=audit_migration
AUDIT_MIGRATION_PASSWORD=GENERATE_WITH_SETUP
JWT_PRIVATE_KEY_B64=GENERATE_WITH_SETUP
JWT_PUBLIC_KEY_B64=GENERATE_WITH_SETUP
PAYMENT_LINK_SIGNING_SECRET=GENERATE_WITH_SETUP
JWT_ISSUER=fluxone-auth
JWT_AUDIENCE=fluxone
RABBITMQ_USER=fluxone
RABBITMQ_PASSWORD=GENERATE_WITH_SETUP
# Solo para comandos locales fuera de Compose; Compose apunta al servicio rabbitmq.
AMQP_HOST=localhost
AMQP_PORT=15672
# URLs para ejecutar procesos localmente; Compose las sustituye por DNS privados.
RAIL_API_URL=http://localhost:3004
AUTH_API_URL=http://localhost:3101/api/v1
PAYMENTS_API_URL=http://localhost:3102/api/v1
AUDIT_API_URL=http://localhost:3103/api/v1
# IDs/passwords demo: generar valores fuertes y conservarlos entre despliegues.
DEMO_A_ID=GENERATE_WITH_SETUP
DEMO_B_ID=GENERATE_WITH_SETUP
DEMO_C_ID=GENERATE_WITH_SETUP
DEMO_A_EMAIL=demo.a@fluxone.local
DEMO_B_EMAIL=demo.b@fluxone.local
DEMO_C_EMAIL=demo.c@fluxone.local
DEMO_A_PASSWORD=GENERATE_WITH_SETUP
DEMO_B_PASSWORD=GENERATE_WITH_SETUP
DEMO_C_PASSWORD=GENERATE_WITH_SETUP
RAIL_MODE=random
RAIL_SCENARIOS=accepted
RAIL_DB_PATH=/data/rail.sqlite
WORKERS_ENABLED=true

AUTH_DEV_PORT=3101
PAYMENTS_DEV_PORT=3102
AUDIT_DEV_PORT=3103
