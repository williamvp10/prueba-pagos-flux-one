#!/bin/sh
set -eu
TASK_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$TASK_ROOT"
if ! command -v uvx >/dev/null 2>&1; then
  echo "Falta uv/uvx. Instala uv: https://docs.astral.sh/uv/getting-started/installation/" >&2
  exit 127
fi
if [ "${1:-}" = "rebuild" ]; then
  shift
  exec uvx --from graphifyy==0.9.62 --with PyYAML==6.0.3 python tools/context/build.py "$@"
fi
exec uvx --from graphifyy==0.9.62 graphify "$@"
